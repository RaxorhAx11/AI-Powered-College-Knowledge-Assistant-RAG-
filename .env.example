# Embedding Configuration
# Examples: sentence-transformers/all-MiniLM-L6-v2, BAAI/bge-small-en-v1.5, Qwen/Qwen2.5-Coder-1.5B
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Primary AI / LLM Provider Configuration ('gemini' or 'ollama')
LLM_PROVIDER=gemini

# Gemini API Configuration (Default / Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local LLM Configuration (Ollama)
# Examples: llama3:latest, qwen2.5:latest, mistral
LLM_MODEL=llama3:latest
OLLAMA_BASE_URL=http://localhost:11434

# RAG Pipeline Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# Paths
DOCUMENTS_DIR=data/documents
VECTORSTORE_DIR=data/vectorstore
